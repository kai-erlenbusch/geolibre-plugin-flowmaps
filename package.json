{
  "name": "geolibre-plugin-flowmaps",
  "version": "0.1.0",
  "description": "A GeoLibre plugin for visualizing flowmaps",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/types/react.d.ts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/types/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./style.css": "./dist/geolibre-plugin-flowmaps.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:geolibre",
    "build:lib": "tsc -p tsconfig.json && vite build",
    "build:geolibre": "vite build --config vite.geolibre.config.ts",
    "build:examples": "vite build --config vite.examples.config.ts",
    "package:geolibre": "npm run build:geolibre && node scripts/package-geolibre-plugin.mjs",
    "install:geolibre": "npm run build:geolibre && node scripts/install-geolibre-plugin.mjs",
    "serve:geolibre": "node scripts/serve-geolibre-plugin.mjs",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "geolibre",
    "maplibre",
    "maplibre-gl",
    "plugin"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@deck.gl/core": "8.9.36",
    "@deck.gl/layers": "8.9.36",
    "@deck.gl/mapbox": "8.9.36",
    "@flowmap.gl/layers": "8.0.3",
    "@luma.gl/core": "8.5.21",
    "@luma.gl/engine": "8.5.21",
    "@luma.gl/shadertools": "8.5.21",
    "leva": "^0.10.1",
    "maplibre-gl": "^5.24.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supercluster": "^8.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.3.0",
    "screenshot-desktop": "^1.15.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^4.1.10"
  }
}
